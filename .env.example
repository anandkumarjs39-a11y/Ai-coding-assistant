# AI Coding Assistant - Environment Variables
# Copy this to .env and fill in your values

# Database (PostgreSQL for production, SQLite for development)
# For local development, leave empty to use SQLite
DATABASE_URL=

# For production with PostgreSQL (docker-compose sets this automatically)
# DATABASE_URL=postgresql://ai_user:secure_password@db:5432/ai_coding_assistant

# Flask
FLASK_ENV=development
PORT=5000
SECRET_KEY=your-super-secret-key-change-in-production

# Frontend API URL (for production, set to your backend URL)
# API_BASE_URL=http://localhost:5000/api

# Database credentials (for docker-compose)
DB_USER=ai_user
DB_PASSWORD=secure_password_change_me

# Optional: Enable mock mode for frontend (no backend needed)
# MOCK_MODE_ENABLED=true