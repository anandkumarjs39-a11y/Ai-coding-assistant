# Frontend Dockerfile (Nginx)
FROM nginx:alpine

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy frontend files
COPY . /usr/share/nginx/html

# Remove unnecessary files
RUN rm -f /usr/share/nginx/html/Dockerfile* /usr/share/nginx/html/docker-compose* /usr/share/nginx/html/nginx.conf /usr/share/nginx/html/.env* /usr/share/nginx/html/backend/Dockerfile /usr/share/nginx/html/.gitignore /usr/share/nginx/html/README.md /usr/share/nginx/html/test_request.json

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]